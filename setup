#!/usr/bin/env python3

import platform
import subprocess
from pathlib import Path

HOME = Path.home()
ZSHRC = HOME / ".zshrc"


def run(cmd, check=True):
    print(f"👉 Running: {cmd}")
    subprocess.run(cmd, shell=True, check=check)


def install_ubuntu():
    run("sudo apt update && sudo apt upgrade -y")
    deps = [
        "build-essential",
        "curl",
        "file",
        "git",
        "zsh",
        "ripgrep",
        "fzf",
        "neovim",
        "libssl-dev",
        "zlib1g-dev",
        "libbz2-dev",
        "libreadline-dev",
        "libsqlite3-dev",
        "wget",
        "llvm",
        "libncurses5-dev",
        "xz-utils",
        "tk-dev",
        "libxml2-dev",
        "libxmlsec1-dev",
        "libffi-dev",
        "liblzma-dev",
    ]
    run(f"sudo apt install -y {' '.join(deps)}")
    if not (HOME / ".pyenv").exists():
        run("curl https://pyenv.run | bash")


def install_macos():
    if subprocess.run("command -v brew", shell=True).returncode != 0:
        run('/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"')
    run("brew install zsh ripgrep fzf neovim pyenv")
    run("$(brew --prefix)/opt/fzf/install --all --no-bash --no-fish")


def install_ohmyzsh():
    if not (HOME / ".oh-my-zsh").exists():
        run(
            'sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended'
        )


def install_zsh_plugin(url, name):
    if (HOME / f".oh-my-zsh/custom/plugins/{name}").exists():
        print(f"Plugin {name} already installed")
        return
    print(f"Installing zsh plugin {name}")
    run(f"git clone {url} {HOME}/.oh-my-zsh/custom/plugins/{name}")


def setup_zsh_plugins():
    install_zsh_plugin("https://github.com/davidparsson/zsh-pyenv-lazy.git", "pyenv-lazy")
    install_zsh_plugin("https://github.com/lukechilds/zsh-nvm", "zsh-nvm")


def main():
    system = platform.system()
    print(f"Detected OS: {system}")

    if system == "Linux":
        install_ubuntu()
    elif system == "Darwin":
        install_macos()
    else:
        print("❌ Unsupported OS.")
        return

    install_ohmyzsh()
    setup_zsh_plugins()

    print("\n✅ Setup complete! Restart your shell or run: exec zsh")


if __name__ == "__main__":
    main()
